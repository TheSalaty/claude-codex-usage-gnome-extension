# Maintainer: TheSalaty <j.ullrich@creedle.io>
_uuid=tripmeter@thesalaty.github.io
pkgname=gnome-shell-extension-tripmeter
pkgver=1.0.0
pkgrel=1
pkgdesc="GNOME Shell extension showing Claude Code and OpenAI Codex usage limits, resets and API-equivalent cost in the top panel"
arch=('any')
url="https://github.com/TheSalaty/tripmeter"
license=('MIT')
depends=('gnome-shell')
makedepends=('npm' 'glib2-devel')
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')

_srcdir="tripmeter-$pkgver"

prepare() {
  cd "$_srcdir"
  # The build needs the TypeScript compiler and the GJS type packages; none of it ships.
  npm ci --cache "$srcdir/npm-cache"
}

build() {
  cd "$_srcdir"
  make schemas assets
}

check() {
  cd "$_srcdir"
  make test
}

package() {
  cd "$_srcdir"
  install -d "$pkgdir/usr/share/gnome-shell/extensions/$_uuid"
  cp -r build/src/. "$pkgdir/usr/share/gnome-shell/extensions/$_uuid/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}

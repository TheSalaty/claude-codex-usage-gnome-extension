post_install() {
  cat <<'EOF'
==> Tripmeter is installed.
==> Enable it once now with:
==>   gnome-extensions enable tripmeter@thesalaty.github.io
==> Then log out and back in. If you skip this now, the next login offers an
==> "Enable Tripmeter" button in a GNOME notification.
EOF
}

post_upgrade() {
  post_install
}
